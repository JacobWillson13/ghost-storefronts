# Copy to .env and adjust.

# directConnection=true is required for the Atlas local image (single-node replica set).
MONGO_URI=mongodb://localhost:27018/?directConnection=true
MONGO_DB=storefronts

# Optional but recommended: a free Socrata app token raises API rate limits.
# Get one at https://data.cityofnewyork.us/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# Where downloaded files land (gitignored).
DATA_DIR=data

# Archive inspections before this date are skipped at download time.
ARCHIVE_SINCE=2010-01-01
